# Optional: Twitter (X) API
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API (or leave unset to use public scraping)
# REDDIT_CLIENT_ID=your_reddit_client_id_here
# REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
# REDDIT_USER_AGENT=FeedbackAnalysisBot/1.0

# YouTube Data API
# YOUTUBE_API_KEY=your_youtube_api_key_here
# RESULT_LIMIT=50

# AI (Groq only): summary + sentiment classification
GROQ_API_KEY=your_groq_api_key_here
# Optional models (defaults: llama-3.3-70b-versatile)
# GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile
# GROQ_SENTIMENT_MODEL=llama-3.3-70b-versatile
# GROQ_SENTIMENT_BATCH_SIZE=30

# Set false to use VADER only (no Groq for sentiment)
# USE_AI_SENTIMENT=true

# Server
# FLASK_DEBUG=False
# PORT=5000
# CORS: defaults allow http://127.0.0.1:3000 and http://localhost:3000
# ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
